# Copy to .env.oracle ON THE ORACLE SERVER, then enter keys there.
# Never commit .env.oracle or paste your real keys into chat.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_MAX_SUBSCRIPTIONS=40
STOCK11_PORT=3011

# Password-only login; Compose stores shared preferences in an internal SQLite volume.
# 4자 이상. 실제 비밀번호는 이 예제 파일이나 GitHub에 커밋하지 마세요.
STOCK11_SYNC_PASSWORD=
STOCK11_SYNC_ORIGIN=
STOCK11_SYNC_ENABLED=true
STOCK11_USER_ID=personal
STOCK11_REDIS_PREFIX=stock11
