# Copy to .env.oracle ON THE ORACLE SERVER, then enter keys there.
# Never commit .env.oracle or paste your real keys into chat.
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_MAX_SUBSCRIPTIONS=40
# Conservative global relay-side KIS REST budget; tune only with KIS guidance.
KIS_REST_MIN_INTERVAL_MS=350
KIS_REST_MAX_CONCURRENCY=2
# Maximum KIS REST rows for the active market board. Watchlist rows retain
# their own priority and share the relay queue/cache.
KIS_REST_PRIORITY_LIMIT=16
# Optional schema-only KIS response diagnostics. Never enable this to log
# credentials; the relay deliberately excludes them in every mode.
KIS_RELAY_DEBUG_FIELDS=0
STOCK11_PORT=3011

# Password-only login; Compose stores shared preferences in an internal SQLite volume.
# 4자 이상. 실제 비밀번호는 이 예제 파일이나 GitHub에 커밋하지 마세요.
STOCK11_SYNC_PASSWORD=
STOCK11_SYNC_ORIGIN=
STOCK11_SYNC_ENABLED=true
STOCK11_USER_ID=personal
STOCK11_REDIS_PREFIX=stock11
