# Local / Vercel default: Naver snapshot and minute history every 30 seconds.
STOCK11_DATA_PROVIDER=naver

# Oracle app: set STOCK11_DATA_PROVIDER=kis and run npm run kis:relay.
KIS_RELAY_URL=http://127.0.0.1:8091
KIS_RELAY_PORT=8091
KIS_RELAY_HOST=127.0.0.1
KIS_MAX_SUBSCRIPTIONS=40
# Set these only in the relay process's server-side environment.
KIS_APP_KEY=
KIS_APP_SECRET=
