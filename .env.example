# Local / Vercel default: Naver snapshot and minute history every 30 seconds.
STOCK11_DATA_PROVIDER=naver

# Oracle app: set STOCK11_DATA_PROVIDER=kis and run npm run kis:relay.
KIS_RELAY_URL=http://127.0.0.1:8091
KIS_RELAY_PORT=8091
KIS_RELAY_HOST=127.0.0.1
KIS_MAX_SUBSCRIPTIONS=40
# Set these only in the relay process's server-side environment.
KIS_APP_KEY=
KIS_APP_SECRET=

# Standard node-redis connection, server only. Never use NEXT_PUBLIC_ here.
REDIS_URL=
# Personal password login: at least 12 characters. Set in server environment.
STOCK11_SYNC_PASSWORD=
# Optional canonical https:// origin, without a trailing slash.
# Required behind Oracle nginx; Vercel can use the incoming request URL.
STOCK11_SYNC_ORIGIN=
STOCK11_SYNC_ENABLED=true
STOCK11_USER_ID=personal
# Same prefix + user ID + Redis database shares state across deployments.
# Use a separate preview prefix if Preview must not modify Production state.
STOCK11_REDIS_PREFIX=stock11

# Oracle-only alternative: server-local SQLite instead of REDIS_URL.
# STOCK11_PROFILE_STORE=sqlite
# STOCK11_SQLITE_PATH=/app/data/stock11-profile.sqlite
