# /etc/stock-interest-sync.env
#
# Copy this file outside Git and chmod 600.
# Do not commit real passwords or API keys.

# Required: public or internal URL that reaches stock5-8 including its base path.
STOCK_INTEREST_SYNC_STOCK5_BASE_URL=https://YOUR_HOST/stock5-8

# Current Oracle paths.
STOCK_INTEREST_SYNC_STOCK11_ENV=/var/www/stock11-7/.env.oracle
STOCK_INTEREST_SYNC_STOCK11_BASE_PATH=/stock11-7
STOCK_INTEREST_SYNC_STOCK5_APP_DIR=/var/www/stock5-8

# Optional. If omitted, STOCK11_SYNC_ORIGIN from .env.oracle is used.
# STOCK_INTEREST_SYNC_STOCK11_ORIGIN=https://YOUR_HOST

# Optional. If omitted, the service reads STOCK5_PASSWORD from the stock5
# process/app environment and finally falls back to stock5's current default.
# STOCK_INTEREST_SYNC_STOCK5_PASSWORD=

STOCK_INTEREST_SYNC_STATE_DIR=/var/lib/stock-interest-sync
STOCK_INTEREST_SYNC_BACKUP_DIR=/var/backups/stock-interest-sync
STOCK_INTEREST_SYNC_INTERVAL_SEC=3

# stock5-8 api/_state.js currently caps the complete item array at 100.
STOCK_INTEREST_SYNC_MAX_STOCK5_ITEMS=100

# Set true only when the HTTPS certificate is valid for the configured host.
STOCK_INTEREST_SYNC_VERIFY_TLS=false
